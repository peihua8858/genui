<style>
element {
  BackGroundColor: #f0f0f0
}
 sequenceDiagram {
    participant {
      FontColor: #000;
      FontSize: 12;
      FontStyle: normal;
      LineColor: #000;
      HorizontalAlignment: left;
    }
    note {
      FontColor: #000;
      FontSize: 12;
      FontStyle: normal;
    }
    arrow {
      FontColor: black;
      LineColor: black;
    }
  }
</style>
title UI渲染时序图
skinparam sequenceMessageAlign left
participant ChatMessageView [
    =ChatMessageView
    ----
    文本消息
]
participant Conversation [
    =Conversation
    ----
    聊天列表
]
participant InternalMessageView [
    =InternalMessageView
    ----
    系统消息
]
participant Surface [
    =Surface
    ----
    组件渲染
]
participant Catalog [
    =Catalog
    ----
    组件集合
]
participant CatalogItem [
    =CatalogItem
    ----
    组件声明
]
Conversation -> Conversation: build
Conversation ->Conversation: _buildUserMessage: 构建用户消息
Conversation -> ChatMessageView:构建用户消息
activate ChatMessageView
ChatMessageView -> Conversation
deactivate ChatMessageView
Conversation ->Conversation:_buildSystemMessage: 构建系统消息
Conversation -> InternalMessageView:构建系统消息
activate InternalMessageView
InternalMessageView -> Conversation
deactivate InternalMessageView
Conversation ->Conversation:__buildModelMessage: 构建模型消息
Conversation -> Surface
Surface -> Surface: _buildWidget
Surface -> Catalog:buildWidget
Catalog -> CatalogItem:widgetBuilder
activate CatalogItem
CatalogItem -> Catalog
deactivate CatalogItem
Catalog -> Surface
Surface -> Conversation
@enduml